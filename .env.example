# Every variable is optional. Copy this file to .env.local to use any of them.

# Where the published ranking snapshot lives (the folder that contains
# ranking.json). On Vercel it defaults to the `data` branch of the deployed
# repository; locally the copy bundled in src/data/seed-snapshot.json is used.
# SNAPSHOT_BASE_URL=https://raw.githubusercontent.com/<owner>/<repo>/data

# Set to 1 to simulate Yahoo Finance being down, to test the fallbacks.
# MARKET_DATA_FORCE_FAIL=1
